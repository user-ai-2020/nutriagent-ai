# Production template for the Compute Engine VM deployment.
#   cp .env.production.example .env   &&   vi .env
#
# Only the values marked REQUIRED need changing. Everything else has a working
# default for the single-VM Docker Compose setup, where services reach each other
# by container name on the internal Docker network.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Docker Hub account holding the nutriagent-* images (pushed by CI).
DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=latest

# Generate with: openssl rand -hex 32
# Deployment aborts if this is missing or still the dev default.
JWT_SECRET=CHANGE_ME

# Live AI. Leave empty to run in mock mode with sample data.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# USDA FoodData Central — live lookup for foods missing from local_foods.
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
FDC_API_KEY=

# Google Programmable Search for the RAG web fallback. Without it the agent uses
# an unofficial DuckDuckGo scrape, which works but is more fragile.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── Infrastructure (defaults work as-is on the VM) ──────────────────────────

# Container-network hostnames, not localhost: compose resolves service names.
DATABASE_URL=postgresql://nutriagent:nutriagent@postgres:5432/nutriagent?connection_limit=3
REDIS_URL=redis://redis:6379

JWT_EXPIRES_IN=7d
API_PORT=3000

ORCHESTRATOR_URL=http://orchestrator:3001
VISION_AGENT_URL=http://vision-agent:3002
NUTRITION_AGENT_URL=http://nutrition-agent:3003
RAG_AGENT_URL=http://rag-agent:3004
TEXT2SQL_AGENT_URL=http://text2sql-agent:3005
GRAPHDB_AGENT_URL=http://graphdb-agent:3006

# Browsers call the portals directly on the VM's external IP, so the gateway must
# accept those origins. Replace <VM-EXTERNAL-IP> after the VM is created.
CORS_ORIGIN=http://<VM-EXTERNAL-IP>:3007,http://<VM-EXTERNAL-IP>:3008

# Meal images on the VM's local disk. Fine for a demo; on GCS the route is
# authenticated with signed URLs instead of being world-readable.
MEAL_IMAGE_STORAGE=local
MEAL_IMAGE_STORAGE_PATH=storage/meal-images
MEAL_IMAGE_PUBLIC_BASE_URL=http://<VM-EXTERNAL-IP>:3000
MEAL_IMAGE_SIGNED_URL_TTL_SECONDS=1800

# RAG / embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
DEFAULT_RESPONSE_LANGUAGE=en
RAG_CACHE_DAYS=7
RAG_SCRAPE_RATE_LIMIT_PER_MIN=10
RAG_PIPELINE_TIMEOUT_MS=90000
RAG_FETCH_TIMEOUT_MS=15000
CHAT_AGENT_TIMEOUT_MS=15000

# Vision clarifying questions — ask only when genuinely uncertain.
VISION_CLARIFY_CONFIDENCE=0.4
# VISION_CLARIFY_MAX_ITEMS=0

# One proxy hop (the portal) — not `true`, which would let a client spoof its IP.
TRUST_PROXY_HOPS=1
