# Tester / grader env — copy to .env:
#   cp .env.tester.example .env
#
# Everything else (DATABASE_URL, JWT, Redis, agent URLs) is set by docker-compose.yml.
# You need a real OpenRouter key to evaluate the app — vision, reranker, RAG, and chat
# all call live models. (Developers may leave the key empty for mock mode; see .env.example.)

# Required: Docker Hub namespace (same as DOCKERHUB_USERNAME in GitHub Secrets)
DOCKERHUB_NAMESPACE=your-dockerhub-username

# Required: OpenRouter API key — https://openrouter.ai/keys
# A basic test session (login, a few meal scans, several chat messages on default models)
# typically costs well under $1.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: pin a specific CI build instead of :latest
# IMAGE_TAG=abc1234
