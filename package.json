{
  "name": "nutriagent-ai",
  "version": "1.0.0",
  "private": true,
  "description": "NutriAgent AI - Nutrition tracking with multi-agent AI",
  "scripts": {
    "dev": "pnpm --filter @nutriagent/shared build && pnpm --filter @nutriagent/db build && pnpm --parallel --filter \"./services/*\" --filter \"./apps/user-portal\" --filter \"./apps/admin-portal\" run dev",
    "dev:packages": "pnpm --parallel --filter @nutriagent/shared --filter @nutriagent/db run dev",
    "dev:api": "pnpm --filter @nutriagent/api-gateway dev",
    "dev:admin": "pnpm --filter @nutriagent/admin-portal dev",
    "dev:mobile": "pnpm --filter @nutriagent/mobile start",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @nutriagent/db generate",
    "db:migrate": "pnpm --filter @nutriagent/db migrate",
    "db:migrate:deploy": "pnpm --filter @nutriagent/db migrate:deploy",
    "db:seed": "pnpm --filter @nutriagent/db seed",
    "db:seed:demo": "pnpm --filter @nutriagent/db seed:demo",
    "db:backfill:daily-steps": "pnpm --filter @nutriagent/db backfill:daily-steps",
    "db:ingest:usda": "pnpm --filter @nutriagent/db ingest:usda",
    "db:setup:checkpointer": "pnpm --filter @nutriagent/orchestrator setup:checkpointer",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint:i18n": "corepack pnpm --filter @nutriagent/shared lint:i18n",
    "check:i18n": "corepack pnpm --filter @nutriagent/shared build",
    "test:i18n": "corepack pnpm --filter @nutriagent/shared build && corepack pnpm --filter @nutriagent/shared test && corepack pnpm --filter @nutriagent/user-portal test && corepack pnpm --filter @nutriagent/admin-portal test && corepack pnpm --filter @nutriagent/mobile test",
    "verify:ssr-rtl": "node scripts/verify-portal-ssr-rtl.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "csv-parse": "^7.0.1"
  }
}
