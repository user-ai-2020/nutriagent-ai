# Test environment — dummy values only, NOT for production use.
# This file is committed to version control intentionally:
# all values here are throwaway test fixtures with no real secrets.

# Required by packages/shared/src/auth.ts at import time
JWT_SECRET=test-secret-not-for-production

# Prevents OpenRouter calls from throwing on missing key during unit tests
# (orchestrator unit tests mock agent calls; no real network calls are made)
OPENROUTER_API_KEY=test-openrouter-key-not-for-production

# DATABASE_URL deliberately points at the shared dev database.
#
# WHY THIS IS SAFE: grep confirms that no *.test.ts file in this package
# imports from @nutriagent/db or calls any prisma write method (create, update,
# delete, upsert, executeRaw, $transaction). All tests are pure-function unit
# tests with zero DB I/O. The URL is present only to satisfy Prisma's env check
# at module load time; no connection is ever opened during test runs.
#
# ⚠️  WARNING FOR FUTURE TEST AUTHORS: if you add a test that performs real DB
# writes (INSERT/UPDATE/DELETE), you MUST switch to an isolated test database
# first — e.g. nutriagent_test on the same Postgres instance — and update this
# URL accordingly. Writing to the dev database from tests risks corrupting real
# data (currently 30 rows in media.meal_images among others).
DATABASE_URL=postgresql://nutriagent:nutriagent@localhost:5433/nutriagent
