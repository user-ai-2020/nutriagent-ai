{
  "name": "@nutriagent/db",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "node scripts/withRootEnv.mjs prisma generate",
    "migrate": "node scripts/withRootEnv.mjs prisma migrate dev",
    "migrate:deploy": "node scripts/withRootEnv.mjs prisma migrate deploy",
    "seed": "node scripts/withRootEnv.mjs tsx prisma/seed.ts",
    "seed:demo": "node scripts/withRootEnv.mjs tsx scripts/seedSyntheticMonth.ts",
    "backfill:daily-steps": "node scripts/withRootEnv.mjs tsx scripts/backfillDailySteps.ts",
    "test:scripts": "node --import tsx --test scripts/**/*.test.ts",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@nutriagent/shared": "workspace:*",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  },
  "prisma": {
    "seed": "node scripts/withRootEnv.mjs tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
