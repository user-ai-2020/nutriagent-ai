# Database
DATABASE_URL=postgresql://nutriagent:nutriagent@localhost:5433/nutriagent

# Redis
REDIS_URL=redis://localhost:6379

# JWT — required (non-empty). Local/dev default below; override in production (see docs/TASKS.md).
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# AI Provider - OpenRouter (https://openrouter.ai)
# Developers: leave OPENROUTER_API_KEY empty to run in mock mode with sample data.
# Testers/graders: use .env.tester.example instead — a real key is required there.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_RERANK_MODEL=cohere/rerank-4-fast
OPENROUTER_APP_NAME=NutriAgent AI
OPENROUTER_APP_URL=http://localhost:3000

# Service URLs (local development)
ORCHESTRATOR_URL=http://localhost:3001
VISION_AGENT_URL=http://localhost:3002
NUTRITION_AGENT_URL=http://localhost:3003
RAG_AGENT_URL=http://localhost:3004
TEXT2SQL_AGENT_URL=http://localhost:3005
GRAPHDB_AGENT_URL=http://localhost:3006

# API Gateway
API_PORT=3000
CORS_ORIGIN=http://localhost:3007,http://localhost:3008,http://127.0.0.1:3007,http://127.0.0.1:3008,http://localhost:8081

# Meal image storage (local dev)
MEAL_IMAGE_STORAGE=local
MEAL_IMAGE_STORAGE_PATH=storage/meal-images
MEAL_IMAGE_PUBLIC_BASE_URL=http://localhost:3000
# GCS signed URL TTL for meal photos (seconds, clamped to 900–3600 = 15–60 min)
MEAL_IMAGE_SIGNED_URL_TTL_SECONDS=1800
# Production only:
# MEAL_IMAGE_STORAGE=gcs
# GCS_MEAL_IMAGES_BUCKET=your-project-meal-images

# Vision clarifying questions (meal photos)
# Below this top-item confidence the graph interrupts to ask the user what they ate.
VISION_CLARIFY_CONFIDENCE=0.4
# Optional: also interrupt when a photo has at least N detected items.
# 0 / unset = never trigger on item count alone (a full plate is not ambiguous).
# VISION_CLARIFY_MAX_ITEMS=0

# RAG / embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
DEFAULT_RESPONSE_LANGUAGE=en
RAG_CACHE_DAYS=7
RAG_SCRAPE_RATE_LIMIT_PER_MIN=10
RAG_PIPELINE_TIMEOUT_MS=90000
# Orchestrator: max wait for chat RAG /retrieve before advise-only (ms)
CHAT_AGENT_TIMEOUT_MS=15000
RAG_FETCH_TIMEOUT_MS=15000

# USDA FoodData Central (optional) — live API fallback for nutrition-fact queries
# when the food isn't in the local `local_foods` table. Get a free key at
# https://fdc.nal.usda.gov/api-key-signup.html — leave empty to skip live USDA lookups.
FDC_API_KEY=

# Google Programmable Search (optional; DDG fallback when unset)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Text2SQL (optional debug)
# TEXT2SQL_DEBUG_SQL=true

# Client apps (optional — defaults to http://localhost:3000)
# NEXT_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Ongoing functional diagnostics (Task 11) — optional monitor container
# DIAGNOSTIC_FAILURE_THRESHOLD=2
# DIAGNOSTIC_FETCH_TIMEOUT_MS=10000
# COMPOSE_PROFILES=monitor   # adds on-demand diagnostic-monitor on :3099 (POST /diagnostics/run)

# Docker Hub image pulls (Task 8.4) — used by docker-compose.yml image: lines.
# Your Docker Hub username or org (no trailing slash), e.g. myuser or myorg.
# Images resolve to ${DOCKERHUB_NAMESPACE}/nutriagent-<service>:${IMAGE_TAG}
DOCKERHUB_NAMESPACE=your-dockerhub-username
# Tag to pull (latest, git SHA from CI, etc.)
IMAGE_TAG=latest
